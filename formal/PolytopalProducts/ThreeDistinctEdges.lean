import PolytopalProducts.IntervalMerge

/-! Three different bipartite edges force a loss of at least three coordinates. -/

noncomputable section

namespace PolytopalProducts.OrderFaces

open scoped Classical

variable {A B : Type*} [LinearOrder A] [Fintype A]

/-- An endpoint is discarded when it is not the first representative of its class. -/
def discarded (key : A → B) : Finset A :=
  Finset.univ.filter fun a ↦ ∃ b < a, key a = key b

private theorem mem_discarded {key : A → B} {x : A} :
    x ∈ discarded key ↔ ∃ y < x, key x = key y := by simp [discarded]

private theorem three_discarded {key : A → B} {a b c : A}
    (ha : a ∈ discarded key) (hb : b ∈ discarded key) (hc : c ∈ discarded key)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    3 ≤ (discarded key).card := by
  have h : ({a,b,c} : Finset A) ⊆ discarded key := by
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl <;> assumption
  have hh := Finset.card_le_card h
  simpa [hab, hac, hbc] using hh

private theorem four_in_class {key : A → B} {a b c d : A}
    (haa : key a = key b) (hab : key a = key c) (hac : key a = key d)
    (h₁ : a ≠ b) (h₂ : a ≠ c) (h₃ : a ≠ d)
    (h₄ : b ≠ c) (h₅ : b ≠ d) (h₆ : c ≠ d) :
    3 ≤ (discarded key).card := by
  let U : Finset A := {a,b,c,d}
  have hn : U.Nonempty := ⟨a, by simp [U]⟩
  let q := U.min' hn
  have hq : q ∈ U := U.min'_mem hn
  have heq (y : A) (hy : y ∈ U) : key y = key a := by
    simp only [U, Finset.mem_insert, Finset.mem_singleton] at hy
    rcases hy with rfl | rfl | rfl | rfl
    · rfl
    · exact haa.symm
    · exact hab.symm
    · exact hac.symm
  have hsub : U.erase q ⊆ discarded key := by
    intro x hx
    obtain ⟨hne, hmem⟩ := Finset.mem_erase.mp hx
    have hlt : q < x := lt_of_le_of_ne (U.min'_le _ hmem) (Ne.symm hne)
    exact mem_discarded.mpr ⟨q, hlt, (heq x hmem).trans (heq q hq).symm⟩
  have hc := Finset.card_le_card hsub
  rw [Finset.card_erase_of_mem hq] at hc
  simpa [U, h₁, h₂, h₃, h₄, h₅, h₆] using hc

private theorem collision {key : A → B} (color : A → Bool) {u v z w t : A}
    (huv : u < v) (hvz : v < z) (hwt : w < t)
    (hu : key u = key z) (hv : key v = key z) (hw : key w = key t)
    (huColor : color u ≠ color z) (hvColor : color v ≠ color z)
    (hwColor : color w ≠ color t)
    (huzwt : (u,z) ≠ (w,t)) (hvzwt : (v,z) ≠ (w,t)) :
    3 ≤ (discarded key).card := by
  by_cases ht : t = z
  · subst t
    have hwu : w ≠ u := fun e ↦ huzwt (by rw [e])
    have hwv : w ≠ v := fun e ↦ hvzwt (by rw [e])
    exact four_in_class hu.symm hv.symm hw.symm (ne_of_gt (huv.trans hvz))
      (ne_of_gt hvz) (ne_of_gt hwt) (ne_of_lt huv) hwu.symm hwv.symm
  · by_cases ht' : t = v
    · subst t
      have hwu : w ≠ u := by
        intro e
        subst w
        cases h₁ : color u <;> cases h₂ : color v <;> cases h₃ : color z <;>
          simp_all
      exact four_in_class hu.symm hv.symm (hv.symm.trans hw.symm) (ne_of_gt (huv.trans hvz))
        (ne_of_gt hvz) (ne_of_gt (hwt.trans hvz)) (ne_of_lt huv) hwu.symm (ne_of_gt hwt)
    · refine three_discarded (a := z) (b := v) (c := t)
        (mem_discarded.mpr ⟨u, huv.trans hvz, hu.symm⟩)
        (mem_discarded.mpr ⟨u, huv, hv.trans hu.symm⟩)
        (mem_discarded.mpr ⟨w, hwt, hw.symm⟩) (ne_of_gt hvz) (Ne.symm ht) (Ne.symm ht')

private theorem collision_either {key : A → B} (color : A → Bool) {u v z w t : A}
    (huz : u < z) (hvz : v < z) (hwt : w < t) (huv : u ≠ v)
    (hu : key u = key z) (hv : key v = key z) (hw : key w = key t)
    (huColor : color u ≠ color z) (hvColor : color v ≠ color z)
    (hwColor : color w ≠ color t)
    (huzwt : (u,z) ≠ (w,t)) (hvzwt : (v,z) ≠ (w,t)) :
    3 ≤ (discarded key).card := by
  rcases lt_or_gt_of_ne huv with h | h
  · exact collision color h hvz hwt hu hv hw huColor hvColor hwColor huzwt hvzwt
  · exact collision color h huz hwt hv hu hw hvColor huColor hwColor hvzwt huzwt

/-- The equality classes generated by three distinct bipartite edges
have at least three fewer representatives than the entire index set. -/
theorem discarded_at_least_three (key : A → B) (color : A → Bool) (x y z : A × A)
    (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z)
    (hx : x.1 < x.2) (hy : y.1 < y.2) (hz : z.1 < z.2)
    (kx : key x.1 = key x.2) (ky : key y.1 = key y.2) (kz : key z.1 = key z.2)
    (cx : color x.1 ≠ color x.2) (cy : color y.1 ≠ color y.2) (cz : color z.1 ≠ color z.2) :
    3 ≤ (discarded key).card := by
  by_cases exy : x.2 = y.2
  · rcases x with ⟨u,a⟩
    rcases y with ⟨v,b⟩
    change a = b at exy
    subst b
    exact collision_either color hx hy hz (fun h ↦ hxy (Prod.ext h rfl))
      kx ky kz cx cy cz hxz hyz
  · by_cases exz : x.2 = z.2
    · rcases x with ⟨u,a⟩
      rcases z with ⟨v,b⟩
      change a = b at exz
      subst b
      exact collision_either color hx hz hy (fun h ↦ hxz (Prod.ext h rfl))
        kx kz ky cx cz cy hxy hyz.symm
    · by_cases eyz : y.2 = z.2
      · rcases y with ⟨u,a⟩
        rcases z with ⟨v,b⟩
        change a = b at eyz
        subst b
        exact collision_either color hy hz hx (fun h ↦ hyz (Prod.ext h rfl))
          ky kz kx cy cz cx hxy.symm hxz.symm
      · exact three_discarded (mem_discarded.mpr ⟨x.1, hx, kx.symm⟩)
          (mem_discarded.mpr ⟨y.1, hy, ky.symm⟩) (mem_discarded.mpr ⟨z.1, hz, kz.symm⟩)
          exy exz eyz

end PolytopalProducts.OrderFaces
