import PolytopalProducts.OrderFaces

/-! Closing selected arrows, and affine directions of the resulting order faces. -/

noncomputable section

namespace PolytopalProducts.OrderFaces

open Set
open scoped Classical

section Closure

variable {W : Type*}

private abbrev TransRel (r : W → W → Prop) :=
  ∀ ⦃x y z⦄, r x y → r y z → r x z

def addArrow (r : W → W → Prop) (a b : W) (x y : W) : Prop :=
  r x y ∨ (r x a ∧ r b y)

theorem addArrow_trans {r : W → W → Prop} (hr : TransRel r) (a b : W) :
    TransRel (addArrow r a b) := by
  intro x y z hxy hyz
  rcases hxy with hxy | ⟨hxa, hby⟩ <;> rcases hyz with hyz | ⟨hya, hbz⟩
  · exact Or.inl (hr hxy hyz)
  · exact Or.inr ⟨hr hxy hya, hbz⟩
  · exact Or.inr ⟨hxa, hr hby hyz⟩
  · exact Or.inr ⟨hxa, hbz⟩

/-- A list of selected forward arrows, each of which is also imposed backwards. -/
def closure (r : W → W → Prop) : List (W × W) → W → W → Prop
  | [] => r
  | (a, b) :: l => addArrow (closure r l) b a

theorem closure_contains {r : W → W → Prop} (l : List (W × W)) {x y : W} (h : r x y) :
    closure r l x y := by
  induction l with
  | nil => exact h
  | cons head tail ih => exact Or.inl ih

theorem closure_trans {r : W → W → Prop} (hr : TransRel r) (l : List (W × W)) :
    TransRel (closure r l) := by
  induction l with
  | nil => exact hr
  | cons head tail ih => exact addArrow_trans ih _ _

theorem closure_reverse {r : W → W → Prop} (hr : ∀ a, r a a) {l : List (W × W)} {a b : W}
    (h : (a, b) ∈ l) : closure r l b a := by
  induction l with
  | nil => simp at h
  | cons head tail ih =>
    rcases List.mem_cons.mp h with rfl | h'
    · exact Or.inr ⟨closure_contains tail (hr b), closure_contains tail (hr a)⟩
    · exact Or.inl (ih h')

theorem closure_le {r s : W → W → Prop} (hs : TransRel s) (l : List (W × W))
    (hbase : ∀ x y, r x y → s x y) (hadd : ∀ a b, (a, b) ∈ l → s b a) {x y : W}
    (h : closure r l x y) : s x y := by
  induction l generalizing x y with
  | nil => exact hbase x y h
  | cons head tail ih =>
    let next := fun a b h ↦ hadd a b (List.mem_cons_of_mem head h)
    rcases h with h | ⟨hx, hy⟩
    · exact ih next h
    · exact hs (hs (ih next hx) (hadd head.1 head.2 (List.mem_cons_self ..))) (ih next hy)

end Closure

variable {V : Type*} [PartialOrder V]

/-- The reach relation generated by making the selected Hasse arrows bidirectional. -/
def reach (s : Finset (Arc V)) : Pinned V → Pinned V → Prop :=
  closure (· ≤ ·) (s.toList.map Subtype.val)

theorem reach_of_le (s : Finset (Arc V)) {x y : Pinned V} (h : x ≤ y) : reach s x y :=
  closure_contains _ h

theorem reach_trans (s : Finset (Arc V)) : TransRel (reach s) :=
  closure_trans (r := (· ≤ ·)) (fun _ _ _ ↦ le_trans) _

theorem reach_reverse (s : Finset (Arc V)) {e : Arc V} (he : e ∈ s) :
    reach s e.val.2 e.val.1 :=
  closure_reverse (fun _ ↦ le_rfl) (List.mem_map.mpr ⟨e, Finset.mem_toList.mpr he, rfl⟩)

/-- The two-way reach relation is the forced equality relation for the seed. -/
def sameClass (s : Finset (Arc V)) (x y : Pinned V) : Prop :=
  reach s x y ∧ reach s y x

def classes (s : Finset (Arc V)) : Setoid (Pinned V) where
  r := sameClass s
  iseqv :=
    ⟨fun _ ↦ ⟨reach_of_le s le_rfl, reach_of_le s le_rfl⟩,
      fun h ↦ ⟨h.2, h.1⟩,
      fun h h' ↦ ⟨reach_trans s h.1 h'.1, reach_trans s h'.2 h.2⟩⟩

variable [Fintype V]

def seededFace (s : Finset (Arc V)) : Set (V → ℝ) :=
  Halfspaces.face (form V) (rhs V) s

theorem mem_seededFace_iff (s : Finset (Arc V)) (z : V → ℝ) :
    z ∈ seededFace s ↔ ∀ x y, reach s x y → value V z x ≤ value V z y := by
  constructor
  · intro hz x y h
    have hmono := (body_iff_monotone V z).mp hz.1
    apply closure_le (r := (· ≤ ·)) (s := fun x y ↦ value V z x ≤ value V z y)
      (fun _ _ _ ↦ le_trans) _ (fun _ _ hxy ↦ hmono hxy) ?_ h
    intro a b hab
    obtain ⟨e, he, eq⟩ := List.mem_map.mp hab
    have hh := ((form_eq_iff V z e).mp (hz.2 e (Finset.mem_toList.mp he))).ge
    rw [congrArg Prod.fst eq, congrArg Prod.snd eq] at hh
    exact hh
  · intro h
    refine ⟨(body_iff_monotone V z).mpr (fun _ _ hxy ↦ h _ _ (reach_of_le s hxy)), ?_⟩
    intro e he
    exact (form_eq_iff V z e).mpr
      ((h _ _ (reach_of_le s e.property.le)).antisymm (h _ _ (reach_reverse s he)))

private def predecessors (s : Finset (Arc V)) (x : Pinned V) : Finset (Pinned V) :=
  Finset.univ.filter fun y ↦ reach s y x

private theorem predecessors_mono {s : Finset (Arc V)} {x y : Pinned V} (h : reach s x y) :
    predecessors s x ⊆ predecessors s y := by
  intro a ha
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, reach_trans s (Finset.mem_filter.mp ha).2 h⟩

private theorem predecessorCount_lt {s : Finset (Arc V)} {x y : Pinned V} (h : reach s x y)
    (hn : ¬reach s y x) : (predecessors s x).card < (predecessors s y).card := by
  apply Finset.card_lt_card
  refine ssubset_of_subset_of_ne (predecessors_mono h) ?_
  intro heq
  have hy : y ∈ predecessors s y := Finset.mem_filter.mpr ⟨Finset.mem_univ _, reach_of_le s le_rfl⟩
  rw [← heq] at hy
  exact hn (Finset.mem_filter.mp hy).2

private theorem normalizedValue_exists (s : Finset (Arc V))
    (hpin : ¬reach s (high V) ⊥) :
    ∃ z : V → ℝ, (∀ x y, reach s x y → value V z x ≤ value V z y) ∧
      ∀ x y, reach s x y → ¬reach s y x → value V z x < value V z y := by
  let raw (x : Pinned V) : ℝ := (predecessors s x).card
  let den := raw (high V) - raw ⊥
  have hden : 0 < den := by
    apply sub_pos.mpr
    change (↑(predecessors s ⊥).card : ℝ) < (predecessors s (high V)).card
    exact_mod_cast predecessorCount_lt (reach_of_le s bot_le) hpin
  let normalized (x : Pinned V) : ℝ := (raw x - raw ⊥) / den
  let z := fun v ↦ normalized (interior V v)
  have hvalue (x : Pinned V) : value V z x = normalized x := by
    cases x using WithBot.recBotCoe with
    | bot => simp [normalized]
    | coe x =>
      cases x using WithTop.recTopCoe with
      | top =>
        change value V z (high V) = normalized (high V)
        simp [normalized, ← show den = raw (high V) - raw ⊥ from rfl, hden.ne']
      | coe x => exact value_interior V z x
  refine ⟨z, ?_, ?_⟩
  · intro x y h
    rw [hvalue, hvalue]
    have hle : raw x ≤ raw y := by
      change (↑(predecessors s x).card : ℝ) ≤ (predecessors s y).card
      exact_mod_cast Finset.card_le_card (predecessors_mono h)
    exact div_le_div_of_nonneg_right (sub_le_sub_right hle _) hden.le
  · intro x y h hn
    rw [hvalue, hvalue]
    have hlt : raw x < raw y := by
      change (↑(predecessors s x).card : ℝ) < (predecessors s y).card
      exact_mod_cast predecessorCount_lt h hn
    exact (div_lt_div_iff_of_pos_right hden).mpr (sub_lt_sub_right hlt _)

theorem seededFace_nonempty_iff (s : Finset (Arc V)) :
    (seededFace s).Nonempty ↔ ¬reach s (high V) ⊥ := by
  constructor
  · rintro ⟨z, hz⟩ h
    have h' := (mem_seededFace_iff s z).mp hz _ _ h
    exact (not_le_of_gt zero_lt_one) (by simpa only [value_high, value_bot] using h')
  · intro h
    obtain ⟨z, hz, -⟩ := normalizedValue_exists s h
    exact ⟨z, (mem_seededFace_iff s z).mpr hz⟩

/-- The tight arc signature after taking closure. -/
def tightArcs (s : Finset (Arc V)) : Finset (Arc V) :=
  Finset.univ.filter fun e ↦ reach s e.val.2 e.val.1

theorem active_seededFace (s : Finset (Arc V)) (hn : (seededFace s).Nonempty) :
    Halfspaces.active (form V) (rhs V) (seededFace s) = tightArcs s := by
  obtain ⟨z, hz, hstrict⟩ := normalizedValue_exists s ((seededFace_nonempty_iff s).mp hn)
  ext e
  rw [Halfspaces.mem_active]
  simp only [tightArcs, Finset.mem_filter, Finset.mem_univ, true_and, form_eq_iff]
  constructor
  · intro h
    by_contra hno
    have ht := hstrict _ _ (reach_of_le s e.property.le) hno
    exact ht.ne (h z ((mem_seededFace_iff s z).mpr hz))
  · intro h y hy
    have hmono := (mem_seededFace_iff s y).mp hy
    exact (hmono _ _ (reach_of_le s e.property.le)).antisymm (hmono _ _ h)

theorem seededFace_eq_iff_tightArcs_eq {s t : Finset (Arc V)}
    (hs : (seededFace s).Nonempty) (ht : (seededFace t).Nonempty) :
    seededFace s = seededFace t ↔ tightArcs s = tightArcs t := by
  constructor
  · intro h
    rw [← active_seededFace s hs, ← active_seededFace t ht, h]
  · intro h
    have normal (u : Finset (Arc V)) (hu : (seededFace u).Nonempty) :
        seededFace u = seededFace (tightArcs u) := by
      have hf : IsExposed ℝ (Halfspaces.body (form V) (rhs V)) (seededFace u) :=
        Halfspaces.face_isExposed _ _ u
      have hh := Halfspaces.eq_face_active _ _ hf hu
      rwa [active_seededFace u hu] at hh
    rw [normal s hs, normal t ht, h]

end PolytopalProducts.OrderFaces

